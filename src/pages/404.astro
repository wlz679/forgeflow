---
// P152: This route MUST stay prerendered (i.e. do NOT add
// `export const prerender = false` here).
//
// Why: Cloudflare Pages' asset layer uses the presence of dist/404.html to
// decide what to serve for an unmatched path. When 404.html exists it is
// returned with a real 404 status. When it is absent, Pages falls back to
// serving dist/index.html with HTTP 200 — which makes every unknown URL on
// the site a "soft 404". Measured on 2026-09-29: /en/blog/ returned
// 200 + the language-redirect stub after 404 was made on-demand.
//
// This route must also keep `getStaticPaths` so it is emitted to
// dist/404.html at build time. Language is per-path, so both variants are
// prerendered; the asset layer serves the same file for either language.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, getLang } from '../i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}

const lang = getLang(Astro);
const title = t('notFound.title', lang);
const description = t('notFound.body', lang);
const homeHref = lang === 'zh' ? '/zh/' : '/en/';
---

<BaseLayout title={title} description={description} pageType="static">
  <Header />
  <main class="max-w-3xl mx-auto px-4 py-16 flex-1 text-center">
    <p class="text-7xl font-extrabold text-gray-300 mb-4">404</p>
    <h1 class="text-2xl font-extrabold text-gray-900 mb-4">{t('notFound.h1', lang)}</h1>
    <p class="text-base text-gray-600 mb-8">{t('notFound.body', lang)}</p>
    <a
      href={homeHref}
      class="inline-block px-6 py-3 bg-[#7C3AED] text-white font-semibold rounded-lg hover:bg-[#6D28D9] transition-colors"
    >
      {t('notFound.homeLink', lang)}
    </a>
  </main>
  <Footer />
</BaseLayout>
