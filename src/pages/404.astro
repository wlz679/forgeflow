---
// P152: 404 route must be rendered on demand, NOT prerendered.
//
// Why this matters: in `output: 'hybrid'`, a route without
// `export const prerender = false` is prerendered to dist/404.html.
// Astro's App.#renderError then short-circuits with
//
//   if (errorRouteData.prerender) {
//     const response = await fetch('/404.html');
//     return this.#mergeResponses(response, originalResponse, { status: 404 });
//   }
//
// which never constructs a RenderContext, so `src/middleware.ts` never
// runs for any 404 path. The 410-Gone interceptor for the removed
// /{lang}/blog/* URLs was silently dead because of this.
//
// With prerender disabled, the error route goes through RenderContext
// with the real middleware, so:
//   - /{en,zh}/blog/*  → 410 Gone (from middleware)
//   - everything else  → next() → this page, rendered on demand
//
// No getStaticPaths: that is only meaningful for prerendered routes.
// The language is derived from the request path instead, since a 404
// can be requested at any URL shape.
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t } from '../i18n';

const firstSegment = Astro.url.pathname.split('/').filter(Boolean)[0];
const lang = firstSegment === 'zh' ? 'zh' : 'en';

const title = t('notFound.title', lang);
const description = t('notFound.body', lang);
const homeHref = lang === 'zh' ? '/zh/' : '/en/';
---

<BaseLayout title={title} description={description} pageType="static">
  <Header />
  <main class="max-w-3xl mx-auto px-4 py-16 flex-1 text-center">
    <p class="text-7xl font-extrabold text-gray-300 mb-4">404</p>
    <h1 class="text-2xl font-extrabold text-gray-900 mb-4">{t('notFound.h1', lang)}</h1>
    <p class="text-base text-gray-600 mb-8">{t('notFound.body', lang)}</p>
    <a
      href={homeHref}
      class="inline-block px-6 py-3 bg-[#7C3AED] text-white font-semibold rounded-lg hover:bg-[#6D28D9] transition-colors"
    >
      {t('notFound.homeLink', lang)}
    </a>
  </main>
  <Footer />
</BaseLayout>
