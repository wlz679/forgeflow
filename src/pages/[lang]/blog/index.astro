---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getAllBlogPosts } from '../../../lib/blog';
import { t, getLang } from '../../../i18n';
import { SITE_URL } from '../../../lib/site-config';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}

const lang = getLang(Astro);
const title = t('blog.page_title', lang);
const description = t('blog.subtitle', lang);

// P72 T2-D1: lang-aware title + excerpt via i18n table (mirrors P69 [slug].astro pattern).
// Fallback to post.title / post.excerpt if a key is missing (defense in depth).
const allPosts = await getAllBlogPosts();
const translatedPosts = allPosts.map(p => {
  const titleKey = `blog.${p.slug}.title`;
  const excerptKey = `blog.${p.slug}.excerpt`;
  return {
    ...p,
    translatedTitle: t(titleKey, lang) !== titleKey ? t(titleKey, lang) : p.title,
    translatedExcerpt: t(excerptKey, lang) !== excerptKey ? t(excerptKey, lang) : p.excerpt,
  };
});

const blogIndexSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Blog',
      '@id': `${SITE_URL}/${lang}/blog/#blog`,
      url: `${SITE_URL}/${lang}/blog/`,
      name: title,
      description,
      inLanguage: lang,
      publisher: { '@id': `${SITE_URL}/#org` },
      blogPost: translatedPosts.map(p => ({
        '@type': 'BlogPosting',
        headline: p.translatedTitle,
        url: `${SITE_URL}/${lang}/blog/${p.slug}/`,
      })),
    },
  ],
});
---

<BaseLayout title={title} description={description} schema={blogIndexSchema} pageType="static">
  <Header />
  <main class="max-w-3xl mx-auto px-4 py-8 flex-1">
    <h1 class="text-2xl font-extrabold mb-2">{t('blog.title', lang)}</h1>
    <p class="text-sm text-gray-500 mb-6">{t('blog.subtitle', lang)}</p>
    <div class="space-y-4">
      {translatedPosts.map(post => (
        <a href={`/${lang}/blog/${post.slug}`} class="block p-4 border border-gray-200 rounded-lg hover:border-red-300 hover:bg-red-50/50 transition-colors">
          <h2 class="text-base font-semibold text-gray-900">{post.translatedTitle}</h2>
          <p class="text-sm text-gray-500 mt-1">{post.translatedExcerpt}</p>
          <span class="text-xs text-red-600 mt-2 inline-block">{t('blog.read_more', lang)}</span>
        </a>
      ))}
    </div>
  </main>
  <Footer />
</BaseLayout>