---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getAllBlogPosts, getBlogPostBySlug } from '../../../lib/blog';
import { t, getLang } from '../../../i18n';
import { SITE_URL } from '../../../lib/site-config';

export async function getStaticPaths() {
  const posts = await getAllBlogPosts();
  const paths: { params: { lang: string; slug: string } }[] = [];
  for (const lang of ['en', 'zh']) {
    for (const post of posts) {
      paths.push({ params: { lang, slug: post.slug } });
    }
  }
  return paths;
}

const { slug, lang } = Astro.params;
const post = await getBlogPostBySlug(slug!);
if (!post) return Astro.redirect(`/${lang}/blog/`);

// P69: lang-aware title + excerpt via i18n table (was lang-agnostic `post.title`).
// Fallback to post.title / post.excerpt if a key is missing (defense in depth).
const translatedTitle = t(`blog.${post.slug}.title`, lang) !== `blog.${post.slug}.title`
  ? t(`blog.${post.slug}.title`, lang)
  : post.title;
const translatedExcerpt = t(`blog.${post.slug}.excerpt`, lang) !== `blog.${post.slug}.excerpt`
  ? t(`blog.${post.slug}.excerpt`, lang)
  : post.excerpt;

const metaTitle = `${translatedTitle} — ForgeFlowKit Blog`;
const metaDescription = translatedExcerpt;

// Blog posts are generated from tools.map(); assign synthetic dates so JSON-LD
// datePublished is present. Real publication dates are not tracked in blog-posts.ts.
const allPosts = await getAllBlogPosts();
const postIndex = allPosts.findIndex(p => p.slug === post.slug);
const baseDate = new Date('2026-06-01');
const datePublished = new Date(baseDate.getTime() + postIndex * 86400000).toISOString().slice(0, 10);

const articleSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${SITE_URL}/${lang}/blog/${post.slug}/#article`,
      headline: translatedTitle,
      description: translatedExcerpt,
      url: `${SITE_URL}/${lang}/blog/${post.slug}/`,
      datePublished,
      // P93: Article requires image field per schema.org. Reuse the same
      // OG image (per-language) so structured data matches the preview.
      image: `${SITE_URL}/og/${post.toolSlug}-${lang}.png`,
      inLanguage: lang,
      author: { '@type': 'Organization', name: 'ForgeFlowKit' },
      publisher: { '@id': `${SITE_URL}/#org` },
      isPartOf: { '@id': `${SITE_URL}/#website` },
    },
  ],
});
---

<BaseLayout title={metaTitle} description={metaDescription} schema={articleSchema} pageType="article" ogImage={`/og/${post.toolSlug}-${lang}.png`}>
  <Header />
  <main class="max-w-3xl mx-auto px-4 py-8 flex-1">
    <nav class="text-xs text-gray-400 mb-4">
      <a href={`/${lang}/`} class="hover:text-red-600">{t('breadcrumb.home', lang)}</a>
      <span class="mx-1">/</span>
      <a href={`/${lang}/blog/`} class="hover:text-red-600">{t('breadcrumb.blog', lang)}</a>
      <span class="mx-1">/</span>
      <span class="text-gray-600">{translatedTitle}</span>
    </nav>
    <article>
      <img
        src={`/og/${post.ogImage}-${lang}.png`}
        alt={translatedTitle}
        width="1200"
        height="630"
        class="w-full aspect-[16/9] object-cover rounded-lg mb-6"
        loading="lazy"
      />
      <h1 class="text-2xl font-extrabold text-gray-900 mb-4">{translatedTitle}</h1>
      <div class="prose prose-sm max-w-none text-gray-700 leading-relaxed space-y-4">
        {(lang === 'zh' && post.bodyZh ? post.bodyZh : post.content).split('\n').map(p => <p>{p}</p>)}
      </div>
    </article>
    <p class="mt-6">
      <a href={`/${lang}/${post.toolSlug}`} class="inline-block px-4 py-2 bg-red-600 text-white font-semibold rounded-lg hover:bg-red-700 transition-colors text-sm">
        {t('blog.try_now', lang, { tool: post.toolName })}
      </a>
    </p>
  </main>
  <Footer />
</BaseLayout>