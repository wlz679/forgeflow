---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ToolCard from '../../components/ToolCard.astro';
import CategoryHero from '../../components/CategoryHero.astro';
import CategoryFaq from '../../components/CategoryFaq.astro';
import CategoryGuides from '../../components/CategoryGuides.astro';
import CategoryOtherNav from '../../components/CategoryOtherNav.astro';
import CategoryDecisionLayer from '../../components/CategoryDecisionLayer.astro';
import { categories } from '../../data/categories';
import { tools } from '../../data/tools';
import { t, getLang } from '../../i18n';
import { getTopicsByLetter } from '../../data/topics';
import { createCollectionPage, createBreadcrumb3 } from '../../lib/seo-factory';
import { getCategoryDecisionLayer } from '../../data/category-decision-layers';
import TopicCard from '../../components/TopicCard.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'zh' } },
  ];
}

const lang = getLang(Astro);
const CATEGORY_ID = 'H';
const CATEGORY_SLUG = 'hiring-team';
const translatedName = t(`category.${CATEGORY_ID}.name`, lang);
const translatedDesc = t(`category.${CATEGORY_ID}.desc`, lang);

const categoryTools = tools
  .filter(tool => tool.categoryId === CATEGORY_ID)
  .map(tool => {
    const titleKey = `tools.${tool.slug}.title`;
    const descKey = `tools.${tool.slug}.description`;
    return {
      ...tool,
      // P81: lang-aware title + description via i18n table (mirrors P80 path-A pattern).
      // Fallback to raw tool.* fields if a key is missing (defense in depth).
      translatedTitle: t(titleKey, lang) !== titleKey ? t(titleKey, lang) : tool.title,
      translatedDescription: t(descKey, lang) !== descKey ? t(descKey, lang) : tool.description,
    };
  });
// P165：这 9 个分类页原本是「lean 模板」，**没有任何分类页级 JSON-LD**
// （只有站点级的 WebSite/SearchAction）⇒ 少 BreadcrumbList（面包屑富结果）与
// ItemList（工具清单富结果）。这是与另外 6 个分类页之间的模板不一致，
// 本批补成同形。
// P167: 分类页的三块内容（介绍段 / 分类指南 / FAQ）。
// 来源 = i18n locale 键（category.<字母>.faq.* / .guide.* / .intro.*）。
const faqItems = [1,2,3,4,5].map(n => ({
  q: t(`category.${CATEGORY_ID}.faq.q${n}.q`, lang),
  a: t(`category.${CATEGORY_ID}.faq.q${n}.a`, lang),
}));

const manualGuides = [1,2,3].map(n => ({
  title: t(`category.${CATEGORY_ID}.guide.${n}.title`, lang),
  desc: t(`category.${CATEGORY_ID}.guide.${n}.desc`, lang),
}));
const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    createCollectionPage({
      lang,
      categorySlug: CATEGORY_SLUG,
      categoryId: CATEGORY_ID,
      categoryName: translatedName,
      categoryDescription: translatedDesc,
      tools: categoryTools.map((tool) => ({ slug: tool.slug, title: tool.translatedTitle })),
    }),
    createBreadcrumb3({
      lang,
      homeLabel: t('breadcrumb.home', lang),
      categoryName: translatedName,
      categorySlug: CATEGORY_SLUG,
      currentPageName: translatedName,
      currentPageSlug: CATEGORY_SLUG,
    }),
  ],
});
const letterTopics = getTopicsByLetter(CATEGORY_ID);
// P165：2.0 批次 1 铺开 —— 分类页的「决策层」（选型链路 + 工具取舍对照）。
// 只有配置了决策层的类别才渲染。
const decisionLayer = getCategoryDecisionLayer(CATEGORY_ID);
---

<BaseLayout
  title={`${translatedName} — ForgeFlowKit`}
  description={translatedDesc}
  schema={schema}
  pageType="static"
>
  <Header />
  <main class="max-w-6xl mx-auto px-4 py-8 flex-1">
    <CategoryHero
      categoryName={translatedName}
      categoryDesc={translatedDesc}
      toolCount={categoryTools.length}
    />

    <section class="mb-10">
      <h2 class="text-2xl font-bold text-gray-900 mb-3">{t(`category.${CATEGORY_ID}.intro.h2`, lang)}</h2>
      <p class="text-sm text-gray-700 leading-relaxed mb-3">{t(`category.${CATEGORY_ID}.intro.1`, lang)}</p>
      <p class="text-sm text-gray-700 leading-relaxed mb-3">{t(`category.${CATEGORY_ID}.intro.2`, lang)}</p>
      <p class="text-sm text-gray-700 leading-relaxed">{t(`category.${CATEGORY_ID}.intro.3`, lang)}</p>
    </section>

    {decisionLayer && (
      <CategoryDecisionLayer categoryId={CATEGORY_ID} layer={decisionLayer} />
    )}

    <section class="mb-10">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">All {categoryTools.length} {translatedName} Tools</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        {categoryTools.map(t => <ToolCard slug={t.slug} title={t.translatedTitle} description={t.translatedDescription} />)}
      </div>
    </section>

    <CategoryFaq categoryId={CATEGORY_ID} faqItems={faqItems} />
    <CategoryGuides categoryId={CATEGORY_ID} manualGuides={manualGuides} />

{letterTopics.length > 0 && (
      <section class="mb-10">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">{t('letter.topics_section.h2', lang)}</h2>
        <p class="text-sm text-gray-600 mb-6">
          {lang === 'zh'
            ? '深入理解本类别的商业问题。每个主题包括教育性指南 + 行业基准 + 关联计算器。'
            : 'Deep-dive into the business questions in this category. Each Topic includes an educational guide, industry benchmarks, and linked calculators.'}
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {letterTopics.map((topic) => (
            <TopicCard topic={topic} lang={lang} variant="full" />
          ))}
        </div>
      </section>
    )}

    <CategoryOtherNav currentCategoryId={CATEGORY_ID} categories={categories} />
  </main>
  <Footer />
</BaseLayout>