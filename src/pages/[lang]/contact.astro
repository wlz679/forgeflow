---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { t, getLang } from '../../i18n';
import { SITE_URL } from '../../lib/site-config';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}

const lang = getLang(Astro);
const title = t('contact.title', lang);
const description = t('contact.description', lang);
const contactSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ContactPage',
      '@id': `${SITE_URL}/${lang}/contact/#webpage`,
      url: `${SITE_URL}/${lang}/contact/`,
      name: title,
      description,
      publisher: { '@id': `${SITE_URL}/#org` },
      inLanguage: lang,
    },
  ],
});

const faq = [1, 2, 3, 4].map((n) => ({
  q: t(`contact.faq.q${n}.q`, lang),
  a: t(`contact.faq.q${n}.a`, lang),
}));
---

<BaseLayout title={title} description={description} schema={contactSchema} pageType="static">
  <Header />
  <main class="max-w-3xl mx-auto px-4 py-8 flex-1">
    <h1 class="text-2xl font-extrabold mb-4">{t('contact.h1', lang)}</h1>
    <div class="prose prose-sm max-w-none text-gray-700 leading-relaxed space-y-4">
      <p>{t('contact.p1', lang)}</p>
      <p>{t('contact.p2', lang)} <a href="mailto:hello@forgeflowkit.com" class="text-[#7C3AED] hover:text-[#6D28D9]">hello@forgeflowkit.com</a></p>
      <p>{t('contact.p3', lang)}</p>

      <h2>{t('contact.channels_h', lang)}</h2>
      <p>{t('contact.channels_intro', lang)}</p>
      <h3>{t('contact.channel_email_h', lang)}</h3>
      <p>{t('contact.channel_email_body', lang)}</p>
      <h3>{t('contact.channel_tool_h', lang)}</h3>
      <p>{t('contact.channel_tool_body', lang)}</p>
      <h3>{t('contact.channel_response_h', lang)}</h3>
      <p>{t('contact.channel_response_body', lang)}</p>

      <h2>{t('contact.faq_h', lang)}</h2>
      {faq.map((item) => (
        <>
          <h3>{item.q}</h3>
          <p>{item.a}</p>
        </>
      ))}

      <h2>{t('contact.scope_h', lang)}</h2>
      <p>{t('contact.scope_body', lang)}</p>

      <h2>{t('contact.partner_h', lang)}</h2>
      <p>{t('contact.partner_body', lang)}</p>
    </div>
  </main>
  <Footer />
</BaseLayout>
