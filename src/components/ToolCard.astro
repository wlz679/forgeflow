---
import { getLang, t } from '../i18n';
export interface Props { slug: string; title: string; description: string; }

const lang = getLang(Astro);

// P167 —— 卡片标题用**短名**，不用传入的 SEO 长名。
//
// 为什么要短名（用户 2026-11-04 截图反馈：「好多计算器的名字都是省略号……」）：
//   · 传入的 `title` 是 **SEO 标题**（`tools.<slug>.title`），带关键词后缀，
//     英文中位 **64** 字符、最长 77（如 "Affiliate Income Calculator — Free
//     Commission + Conversion Forecast (2026)"）；
//   · 在 4 列布局下单行约 31 字符 ⇒ **85% 的卡片标题被截断**；
//   · 短名 `tools.<slug>.shortTitle`（P167 从同一标题机械派生，取 ' — ' 前缀）
//     中位 **25** 字符、最长 40 ⇒ 两行内放得下。
//
// ⚠️ **SEO 长名没有被放弃**：工具详情页的 `<title>` / h1 / 面包屑 / RelatedTools
//   仍然用长名 ⇒ 搜索引擎看到的标题一个字都没少。
//   这里只改**给人扫的卡片**。
//
// ⭐ 为什么在组件里解析而不是在 16 个页面各写一遍：
//   16 个页面里 9 个是 `displayTools.map(t => <ToolCard title={t.translatedTitle} …>)`、
//   7 个是直接传 `categoryTools` —— 两种写法 ⇒ 在页面里改要改两处、且容易漏；
//   在组件里解析 ⇒ **一处改动，16 个页面全部受益**，且以后新增页面自动生效。
//
// ⚠️ fallback：`t()` 在键缺失时返回键名本身 ⇒ 必须显式判断，否则卡片标题
//   会显示成字面量 "tools.xxx.shortTitle"。
const shortTitleKey = `tools.${Astro.props.slug}.shortTitle`;
const shortTitleRaw = t(shortTitleKey, lang);
const shortTitle = shortTitleRaw === shortTitleKey ? Astro.props.title : shortTitleRaw;
---

<!-- P141-B2-T1: HTML invalid <a> 嵌套 <button> → 改为真正的 siblings (用 <div> wrapper) -->
<div class="group relative flex flex-col p-5 bg-gray-50 border border-gray-100 rounded-xl hover:border-[#7C3AED]/30 hover:bg-white hover:shadow-lg hover:shadow-[#7C3AED]/5 transition-all duration-300 hover:-translate-y-1">
  <!-- Favorite toggle — sibling (NOT inside <a>); absolute + z-20 sits above card link -->
  <button type="button"
          class="favorite-star absolute top-3 right-3 p-1.5 rounded-full bg-white/80 hover:bg-white border border-gray-100 hover:border-[#7C3AED]/40 transition-all duration-200 hover:scale-110 z-20"
          data-favorite-toggle
          data-favorite-slug={Astro.props.slug}
          aria-label={t('favorites.aria.add', lang)}>
    <svg aria-hidden="true" class="w-4 h-4 text-gray-400 hover:text-[#7C3AED] transition-colors duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.957a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.37 2.448a1 1 0 00-.364 1.118l1.287 3.957c.3.922-.755 1.688-1.54 1.118l-3.37-2.448a1 1 0 00-1.176 0l-3.371 2.448c-.784.57-1.838-.196-1.539-1.118l1.287-3.957a1 1 0 00-.364-1.118L2.07 8.384c-.783-.57-.38-1.81.588-1.81h4.162a1 1 0 00.95-.69l1.286-3.957z" />
    </svg>
  </button>
  <!-- Card link — sibling (NOT wrapping <button>); holds visible content -->
  <a href={`/${lang}/${Astro.props.slug}`} class="flex flex-col flex-1" data-tool-slug={Astro.props.slug}>
    <div class="flex items-start justify-between mb-3">
      <div class="w-10 h-10 bg-white rounded-lg flex items-center justify-center border border-gray-100 shadow-sm">
        <svg aria-hidden="true" class="w-5 h-5 text-[#7C3AED]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
        </svg>
      </div>
      <div class="opacity-0 group-hover:opacity-100 transition-opacity duration-300">
        <svg aria-hidden="true" class="w-5 h-5 text-[#7C3AED]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </div>
    </div>
    <!-- P167: 标题原本用 `truncate`（单行 + 省略号）且**没有 title 属性** ⇒
         实测 18% 的工具标题（18 / 100）在 4 列布局下被砍掉（如 "Affilate Income Calculat…"），
         而 hover 也不显示全名（下面的描述反而有 title）。
         ⇒ 改成 `line-clamp-2`：最多两行、完整可读，同时把 `title` 补上，
            两行仍放不下时 hover 出原生 tooltip。
         ⚠️ 纯视觉层改动：**DOM 里的文字一直就是完整的**（truncate 只是 overflow:hidden），
            ⇒ 爬虫看到的文字没变，SEO/AdSense 判定不受影响；这是给人看的问题。 -->
    <h3 class="text-base font-semibold text-gray-900 group-hover:text-[#7C3AED] transition-colors duration-300 mb-2 line-clamp-2" title={shortTitle}>{shortTitle}</h3>
    <p class="text-sm text-gray-500 line-clamp-2 group-hover:text-gray-600 transition-colors duration-300 mt-auto" title={Astro.props.description}>{Astro.props.description}</p>
  </a>
  <div class="absolute bottom-0 left-0 right-0 h-0.5 bg-gradient-to-r from-[#7C3AED] to-transparent scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left rounded-b-xl"></div>
</div>