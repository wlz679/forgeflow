---
import CopyButton from './CopyButton.astro';
import { t, getLang } from '../i18n';
import { isCalcOutputTipLine } from '../lib/calc-output-i18n';
export interface Props { text: string; index: number; hideIndex?: boolean; preserveTip?: boolean; rawText?: string; }
const { text, index, hideIndex, preserveTip, rawText } = Astro.props;
const lang = getLang(Astro);
// I2-review: strip the standalone `💡 Tip:` footer for legacy business calcs
// to avoid double-rendering. v3 calcs want the line preserved (it's one of
// the 5+1 body sections, not a footer) — opt in via preserveTip.
// P168 B3-7：tip 行的过滤必须**语言无关** ——
//   zh 页的 translateCalcOutput 会把「💡 Tip:」改写成「💡 提示:」
//   ⇒ 只认英文标记 ⇒ zh 卡片多出一条 en 没有的 tip 行（实测 16 页，其中 mrr /
//     project_profitability 是本批试点），
//   ⇒ 且 data-calc-output-raw 里的**英文原文**被正确过滤 ⇒ SSR 与客户端
//     beautify 的行结构不一致（hydration 后 tip 消失 ⇒ 布局跳动）。
//   ⭐ 标记清单与判定在 src/lib/calc-output-i18n.ts（**唯一实现**）
//     ⇒ 源码级守卫能直接单测，变异台子也能覆盖（见 G11）。
const stripped = preserveTip
  ? text
  : text.split('\n').filter((l: string) => !isCalcOutputTipLine(l)).join('\n');
const titleLine = stripped.split('\n')[0];
const restLines = stripped.split('\n').slice(1).join('\n');
// P168 B3-7：**token 原文**（未经 token 渲染）的同一段正文 ——
//   客户端 beautifySections 用它识别区块（SSR 已渲成中文 ⇒ textContent 是中文 ⇒ 失配）。
//   ⚠️ 必须与 restLines **同样的行结构**（去掉首行标题 + 同样的 Tip 处理）⇒ 结构才一致。
const rawRestLines = rawText === undefined
  ? undefined
  : (preserveTip ? rawText : rawText.split('\n').filter((l: string) => !isCalcOutputTipLine(l)).join('\n')).split('\n').slice(1).join('\n');
---
{
  hideIndex ? (
    <div class="group bg-white border border-gray-100 rounded-2xl overflow-hidden hover:border-[#7C3AED]/30 transition-all duration-300">
      <div class="flex items-start justify-between gap-3 p-5 pb-3 border-b border-gray-50">
        <h3 class="text-base font-bold text-gray-900">{titleLine}</h3>
        <div class="flex items-center gap-0.5 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
          <button type="button"
                  class="inline-flex items-center gap-1 text-xs text-gray-400 hover:text-[#7C3AED] font-medium px-2 py-1.5 rounded-lg hover:bg-gray-50 transition-colors shrink-0"
                  data-history-save
                  aria-label={t('history.btn.save', lang)}>
            <svg aria-hidden="true" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/></svg>
            <span>{t('history.btn.save', lang)}</span>
          </button>
          <CopyButton text={stripped} />
          <button type="button" class="export-btn inline-flex items-center gap-1 text-xs text-gray-400 hover:text-[#059669] font-medium px-2 py-1.5 rounded-lg hover:bg-gray-50 transition-all shrink-0" data-export={text}>
            <svg aria-hidden="true" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <span>{t('btn.export', lang)}</span>
          </button>
        </div>
      </div>
      <div class="p-5 bg-gray-50/50 text-sm text-gray-700 leading-relaxed whitespace-pre-line font-mono" data-history-result data-calc-output-raw={rawRestLines}>{restLines}</div>
    </div>
  ) : (
    <div class="group flex items-start justify-between gap-4 p-4 bg-white border border-gray-100 rounded-xl hover:border-[#7C3AED]/30 hover:shadow-md hover:shadow-[#7C3AED]/5 transition-all duration-300">
      <span class="text-xs font-bold text-gray-400 shrink-0 pt-0.5 w-5">#{index + 1}</span>
      <span class="text-sm text-gray-700 flex-1 leading-relaxed whitespace-pre-line" data-history-result>{stripped}</span>
      <div class="opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center gap-0.5">
        <button type="button"
                class="inline-flex items-center gap-1 text-xs text-gray-400 hover:text-[#7C3AED] font-medium px-2 py-1.5 rounded-lg hover:bg-gray-50 transition-colors shrink-0"
                data-history-save
                aria-label={t('history.btn.save', lang)}>
          <svg aria-hidden="true" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/></svg>
          <span>{t('history.btn.save', lang)}</span>
        </button>
        <CopyButton text={stripped} />
      </div>
    </div>
  )
}

<script>
  document.querySelectorAll('.export-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var lines = [];
      lines.push('ForgeFlowKit — ' + (document.querySelector('h1')?.textContent || 'Calculator'));
      lines.push('Generated: ' + new Date().toLocaleString());
      var form = document.getElementById('tool-form');
      if (form) {
        lines.push('');
        lines.push('INPUTS');
        lines.push('------');
        form.querySelectorAll('input, select').forEach(function(f) {
          var label = document.querySelector('label[for="' + f.id + '"]');
          lines.push((label ? label.textContent.trim() : f.name) + ': ' + (f.value || '(empty)'));
        });
      }
      lines.push('');
      lines.push('RESULTS');
      lines.push('-------');
      lines.push(this.dataset.export);
      var blob = new Blob([lines.join('\n')], { type: 'text/plain' });
      var a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'forgeflowkit-result-' + new Date().toISOString().slice(0, 10) + '.txt';
      a.click();
      URL.revokeObjectURL(a.href);
      var t = this;
      t.style.color = '#059669';
      setTimeout(function() { t.style.color = ''; }, 1500);
    });
  });
</script>
