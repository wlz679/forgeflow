---
// P140a-T5 (revised after T5 reviewer design fix): Renders ONE of 4 H2 prose
// sections from a Calculator Content Collection entry. Each panel shows
// only the matching section's body — NOT the full markdown.
//
// Section extraction strategy:
//   Astro 4.x does not expose a "render only this section" API. Instead of
//   full entry.render() (which returns all 4 sections' Content at once), we
//   read entry.body as raw markdown string and extract the matching H2's
//   body via a regex split. The extracted text is rendered as plain HTML
//   paragraphs (via `set:html` with simple markdown-aware transforms).
//   This trades full markdown rendering for guaranteed correct per-section
//   isolation — acceptable because the prose is paragraph-leaning and the
//   `prose` Tailwind class handles basic typography.
//
// Section labels match the 4 H2s in src/content/tools/<slug>.md (P140a-T4):
//   'intro'        → '## What This Calculator Measures'           (en)
//                       '## 这个计算器衡量什么'                      (zh)
//   'methodology'  → '## How It Works (Methodology)'              (en)
//                       '## 计算方法'                                (zh)
//   'limitations'  → '## Limitations & When Not To Use'           (en)
//                       '## 局限性 / 何时不适用'                     (zh)
//   'example'      → '## Worked Example'                          (en)
//                       '## 案例走读'                                (zh)
//   Pattern is chosen as substring-of-H2 so it survives phrasing variants.
//
// P140a note: this component is created but NOT yet wired into
// src/pages/[lang]/[slug].astro — that hookup is P140b-T4.

import type { CollectionEntry } from 'astro:content';

export interface Props {
  entry: CollectionEntry<'tools'>;
  section: 'intro' | 'methodology' | 'limitations' | 'example' | 'assumptions' | 'common_mistakes';
}

const { entry, section } = Astro.props;

interface SectionHeading {
  match: string;        // regex pattern: substring of H2 text to find
  containerClass: string;
  markerText: string;
  markerBg: string;
  bodyClass: string;
}

const SECTION_HEADINGS: Record<Props['section'], SectionHeading> = {
  intro: {
    match: 'What This Calculator Measures',
    containerClass: 'rounded-2xl border border-purple-200 bg-purple-50/60 p-6 my-8',
    markerText: '📌',
    markerBg: 'bg-purple-100/80',
    bodyClass: 'prose prose-sm max-w-none text-gray-800',
  },
  methodology: {
    match: 'How It Works',
    containerClass: 'rounded-2xl border border-gray-200 bg-gray-50/60 p-6 my-8',
    markerText: '⚙️',
    markerBg: 'bg-gray-100',
    bodyClass: 'prose prose-sm max-w-none text-gray-800',
  },
  limitations: {
    match: 'Limitations',
    containerClass: 'rounded-2xl border border-amber-200 bg-amber-50/40 p-6 my-8',
    markerText: '⚠️',
    markerBg: 'bg-amber-100/80',
    bodyClass: 'prose prose-sm max-w-none text-gray-700 italic',
  },
  example: {
    match: 'Worked Example',
    containerClass: 'rounded-2xl border border-emerald-200 bg-emerald-50/40 p-6 my-8',
    markerText: '📋',
    markerBg: 'bg-emerald-100/80',
    bodyClass: 'prose prose-sm max-w-none text-gray-800',
  },
  assumptions: {
    match: 'Assumptions',
    containerClass: 'rounded-2xl border border-sky-200 bg-sky-50/40 p-6 my-8',
    markerText: '🔍',
    markerBg: 'bg-sky-100/80',
    bodyClass: 'prose prose-sm max-w-none text-gray-800',
  },
  common_mistakes: {
    match: 'Common Mistakes',
    containerClass: 'rounded-2xl border border-rose-200 bg-rose-50/40 p-6 my-8',
    markerText: '⚠️',
    markerBg: 'bg-rose-100/80',
    bodyClass: 'prose prose-sm max-w-none text-gray-800',
  },
};

// en + zh variants — we try each in turn, first match wins. Pattern is
// intentionally permissive (substring match on H2 text). If neither matches
// we emit an empty panel — caller is responsible for ensuring all 4 H2s
// are present (enforced by tests/content-prose-shape-guard.test.ts).
const SECTION_VARIANTS: Record<Props['section'], string[]> = {
  intro:        ['What This Calculator Measures', '这个计算器衡量什么'],
  methodology:  ['How It Works', '计算方法'],
  limitations:  ['Limitations', '局限性'],
  example:      ['Worked Example', '案例走读'],
  assumptions:    ['Assumptions',                '假设与边界'],
  common_mistakes: ['Common Mistakes',           '常见误区'],
};

const cfg = SECTION_HEADINGS[section];
const variants = SECTION_VARIANTS[section];

/**
 * Extract the body of one H2 section from raw markdown.
 * Returns the text BETWEEN the matched H2 line and the next H2 (or end).
 */
function extractSection(body: string, matchers: string[]): string {
  // Split body at line-starts that introduce a new `## ` H2 section. Each
  // element starts with the H2 line. We pick the element whose H2 contains
  // one of the `matchers` substrings (en or zh variant).
  //
  // Why line-split instead of a regex with EOF lookahead:
  //   JS regex doesn't have PCRE-style `\Z`. A `(?!\s\S)` lookahead is
  //   satisfied at virtually any position (wherever the next 2 chars are
  //   not whitespace-followed-by-nonspace), so capturing the empty match
  //   before the section's first character. Splitting + matching by H2
  //   text is unambiguous.
  const sections = body.split(/\n(?=## )/);
  for (const section of sections) {
    const headerLineEnd = section.indexOf('\n');
    const header = headerLineEnd >= 0 ? section.slice(0, headerLineEnd) : section;
    for (const m of matchers) {
      if (header.includes(m)) {
        // Return everything after the H2 line, trimmed.
        return headerLineEnd >= 0 ? section.slice(headerLineEnd + 1).trim() : '';
      }
    }
  }
  return '';
}

/**
 * Best-effort markdown → HTML transform for prose paragraphs.
 * Handles:
 *   - ```fenced code blocks``` → <pre><code>...</code></pre>
 *   - blank-line-separated paragraphs → <p>...</p>
 *   - `inline code` → <code>...</code>
 *   - **bold** → <strong>...</strong>
 *   - *italic* → <em>...</em>
 *   - markdown tables (|...| lines) → <table><tr><td>...</td></tr></table>
 * Anything else is treated as plain text and escaped.
 *
 * This is intentionally minimal — no full CommonMark parser — because the
 * prose content is paragraph-leaning with light formatting. A real
 * markdown library (marked / remark) can be substituted later if richer
 * formatting becomes necessary. For AdSense E-E-A-T compliance, plain
 * paragraphs with paragraph breaks already satisfies the prose-depth
 * requirement.
 */
function simpleMarkdownToHtml(md: string): string {
  // Block-level placeholders. Code blocks / tables / lists all get extracted
  // first (each into its own numbered array), then the in-place transforms
  // (italic, bold, inline code) operate on the remaining paragraph text only.
  // At the very end, placeholders are inlined into their full HTML.
  // NB: this 2-phase approach prevents inline transforms from corrupting
  // block-level constructs — e.g. `*` is a list-marker, not an italic opener.

  // 1a. Fenced code blocks → __CODE_BLOCK_n__ placeholders.
  const codeBlocks: string[] = [];
  let s = md.replace(/```[a-zA-Z0-9_-]*\n([\s\S]*?)```/g, (_m, code) => {
    const idx = codeBlocks.push(`<pre class="bg-white border border-gray-200 rounded-lg p-3 my-3 overflow-x-auto text-xs"><code>${escapeHtml(code)}</code></pre>`) - 1;
    return `__CODE_BLOCK_${idx}__`;
  });

  // 1b. GFM tables → __TABLE_BLOCK_n__ placeholders.
  //    Inside a JS regex literal `\|` matches a literal pipe; `\n` matches newline.
  //
  //    Compensating newline trick: each iteration consumes one trailing `\n`,
  //    so a 5-row table eats 5 newlines. To keep the placeholder cleanly
  //    separable in the paragraph splitter, we append one extra `\n` to
  //    the replacement so the table block + 1 trailing blank line + whatever
  //    blank lines the markdown already had = `\n\n__placeholder__\n\n`-ish.
  //    Without this, the trailing `\n\n` markdown blank line collapses to
  //    `\n`, the paragraph splitter treats placeholder + next paragraph as
  //    ONE paragraph, and the table ends up wrapped in `<p>`.
  const tableBlocks: string[] = [];
  s = s.replace(/(^\|[^\n]*\|[^\n]*\n)+/gm, (tableBlock) => {
    const rows = tableBlock.trim().split('\n').filter(Boolean);
    if (rows.length < 2) return tableBlock;
    const headerCells = rows[0].split('|').map(c => c.trim()).filter(Boolean);
    // rows[1] is the | --- | --- | separator; skip
    const bodyRows = rows.slice(2).map(r => r.split('|').map(c => c.trim()).filter(Boolean));
    let html = '<table class="w-full text-xs my-3 border-collapse">';
    html += '<thead><tr>';
    // P141-B3-T5b: escape header/body cells to prevent XSS via markdown table
    // content (column text was previously injected unescaped).
    for (const h of headerCells) html += `<th class="text-left px-2 py-1.5 font-semibold text-gray-600 border-b border-gray-200">${escapeHtml(h)}</th>`;
    html += '</tr></thead><tbody>';
    for (const row of bodyRows) {
      html += '<tr>';
      for (const c of row) html += `<td class="px-2 py-1.5 text-gray-700 border-b border-gray-100">${escapeHtml(c)}</td>`;
      html += '</tr>';
    }
    html += '</tbody></table>';
    const idx = tableBlocks.push(html) - 1;
    return `\n__TABLE_BLOCK_${idx}__\n`;
  });

  // 1c. Lists — ordered (`1. ` / `2. `) + unordered (`- ` or `* ` markers).
  //    MUST run BEFORE inline italic transform, otherwise `*` would be eaten as italic.
  //    Same compensating-newline trick as tables (above): each list-line
  //    consumes its trailing \n, so the trailing blank-line after a list can
  //    collapse to a single \n and break paragraph-split. We append one extra
  //    \n to the replacement so the paragraph splitter keeps a clean boundary.
  const listBlocks: string[] = [];
  const olRe = /((?:^[ \t]*\d+\.[ \t]+\S.*\n?)+)/gm;
  s = s.replace(olRe, (listBlock) => {
    const items = listBlock.trim().split('\n').map(line => line.replace(/^[ \t]*\d+\.[ \t]+/, '').trim());
    const html = '<ol class="list-decimal pl-5 my-3 space-y-1">'
      + items.map(it => `<li>${it}</li>`).join('')
      + '</ol>';
    const idx = listBlocks.push(html) - 1;
    return `\n__LIST_BLOCK_${idx}__\n`;
  });
  const ulRe = /((?:^[ \t]*[-*][ \t]+\S.*\n?)+)/gm;
  s = s.replace(ulRe, (listBlock) => {
    const items = listBlock.trim().split('\n').map(line => line.replace(/^[ \t]*[-*][ \t]+/, '').trim());
    const html = '<ul class="list-disc pl-5 my-3 space-y-1">'
      + items.map(it => `<li>${it}</li>`).join('')
      + '</ul>';
    const idx = listBlocks.push(html) - 1;
    return `\n__LIST_BLOCK_${idx}__\n`;
  });

  // 2. Inline transforms on what's left (now safely — block constructs are placeholders)
  s = escapeHtml(s);
  s = s.replace(/`([^`]+)`/g, '<code class="bg-gray-100 px-1 rounded text-sm">$1</code>');
  s = s.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
  s = s.replace(/(?<!\*)\*([^*]+)\*(?!\*)/g, '<em>$1</em>');

  // 5. Split on blank lines → paragraphs; re-inline block placeholders.
  const paragraphs = s.split(/\n\s*\n/);
  let html = '';
  for (const p of paragraphs) {
    const text = p.trim();
    if (!text) continue;
    // Standalone block placeholder → emit HTML directly (no <p> wrap).
    const standAlone = text.match(/^__CODE_BLOCK_(\d+)__$|^__TABLE_BLOCK_(\d+)__$|^__LIST_BLOCK_(\d+)__$/);
    if (standAlone) {
      const codeIdx = standAlone[1];
      const tableIdx = standAlone[2];
      const listIdx  = standAlone[3];
      if (codeIdx  !== undefined) html += codeBlocks[Number(codeIdx)];
      if (tableIdx !== undefined) html += tableBlocks[Number(tableIdx)];
      if (listIdx  !== undefined) html += listBlocks[Number(listIdx)];
      continue;
    }
    // Inline placeholder substitutions within a paragraph.
    let inlined = text
      .replace(/__CODE_BLOCK_(\d+)__/g, (_m, idx) => codeBlocks[Number(idx)])
      .replace(/__TABLE_BLOCK_(\d+)__/g, (_m, idx) => tableBlocks[Number(idx)])
      .replace(/__LIST_BLOCK_(\d+)__/g,  (_m, idx) => listBlocks[Number(idx)]);
    // Convert single newlines within a paragraph to <br/>
    const withBreaks = inlined.replace(/\n/g, '<br/>');
    html += `<p class="leading-relaxed my-3">${withBreaks}</p>`;
  }

  return html;
}

function escapeHtml(s: string): string {
  return s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

const sectionBody = extractSection(entry.body ?? '', variants);
const sectionHtml = simpleMarkdownToHtml(sectionBody);
---

<section class={cfg.containerClass} aria-label={section}>
  <div class:list={['inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold mb-3', cfg.markerBg]}>
    <span aria-hidden="true">{cfg.markerText}</span>
    <span class="uppercase tracking-wider text-gray-700">{section}</span>
  </div>
  {sectionHtml
    ? <div class={cfg.bodyClass} set:html={sectionHtml} />
    : <p class="text-xs text-gray-500 italic">No prose yet for this section.</p>
  }
</section>

<style>
  /* No global H2 suppression needed — we extract per-section body via regex
     and feed only the chosen section's markdown into simpleMarkdownToHtml().
     The 4 panels now show 4 distinct bodies, not 4 copies. */
</style>

